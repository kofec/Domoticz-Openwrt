#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1
PROG=/usr/sbin/sofar-reader

start_inverter() {
	local section="$1"
	local enabled

	config_get_bool enabled "$section" enabled 0
	[ "$enabled" -eq 1 ] || return 0

	procd_open_instance "$section"
	procd_set_param command "$PROG" -s "$section"
	procd_set_param respawn 3600 30 0
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	config_load sofar-reader
	config_foreach start_inverter inverter
}

service_triggers() {
	procd_add_reload_trigger sofar-reader
}
