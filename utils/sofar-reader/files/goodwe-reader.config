
config domoticz 'domoticz'
	option host '127.0.0.1'
	option port '8080'
	# Only needed when 127.0.0.1 is not in Domoticz "Local Networks"
	option username ''
	option password ''

# One section per inverter, each runs as its own procd instance.
# Test with: goodwe-reader -s home -n -v
config inverter 'home'
	option enabled '0'
	# Inverter (its Wi-Fi module) in the LAN, Modbus RTU over UDP
	option host '192.168.1.60'
	option port '8899'
	option interval '300'

	# Domoticz device idx, 0 or unset = not sent
	# Custom sensor or Usage (Electric), W
	option idx_power ''
	# Voltage, sent only between 180 and 260 V
	option idx_voltage ''
	#option idx_today_energy ''
	#option idx_total_energy ''
	#option idx_energy ''
	#option idx_temperature ''
	#option idx_frequency ''
	#option idx_status ''

	# 0 W after zero_delay s without a reading; a notification after
	# notify_after s without one, repeated while it lasts (0 = off)
	option zero_delay '900'
	option notify_after '86400'
	#option notify_subject 'goodwe-reader'
	#option notify_text 'No data from the inverter for'
	#option notify_back_text 'Inverter data back after'
	#option notify_error_text 'Last error:'

	# No questions from sunset + margin to sunrise - margin (Domoticz times)
	option night '1'
	option night_margin '30'

	# SEMS+: fallback when the inverter does not answer in the LAN, and
	# once a day yesterday's gaps in PVOutput filled from its power curve.
	# gw_account, gw_password and gw_station_id come from sems_file.
	option sems '1'
	option sems_file '/root/gw2pvo.cfg'
	option check_yesterday '1'

	# PVOutput, empty pvo_system_id = no upload. Keep the key in a file.
	#option pvo_system_id ''
	#option pvo_api_key_file '/root/gw2pvo.cfg'
	#option pvo_api_key_name 'pvo_api_key'
