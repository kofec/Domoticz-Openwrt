
config domoticz 'domoticz'
	option host '127.0.0.1'
	option port '8080'
	# Only needed when 127.0.0.1 is not in Domoticz "Local Networks"
	option username ''
	option password ''

# One section per inverter, each runs as its own procd instance.
# Test with: sofar-reader -s ludynia -n -v
config inverter 'ludynia'
	option enabled '0'
	# LSW-3/LSE data logger
	option host '192.168.1.50'
	option port '8899'
	# Logger S/N (sticker on the logger), not the inverter S/N
	option serial ''
	option interval '300'
	# Registers 0x0105-0x0114 (string 1-8 voltage/current)
	option read_strings '0'
	# Send 0 W when the logger goes offline (at night), after zero_delay s
	option zero_offline '1'
	option zero_delay '900'
	# Domoticz notification after notify_after s without data, 0 = off
	option notify_after '86400'
	#option notify_subject 'sofar-reader'
	#option notify_text 'No data from the inverter for'

	# Domoticz device idx, 0 or unset = not sent
	# Electric (Instant+Counter), "From device": output_power;total Wh
	option idx_energy ''
	# Text: "Normal" or "FAULT: ID.. description"
	option idx_status ''
	# Any value from "sofar-reader -n" as idx_<name>, e.g.
	#option idx_pv1_power ''
	#option idx_pv2_power ''
	#option idx_pv1_voltage ''
	#option idx_l1_voltage ''
	#option idx_grid_frequency ''
	#option idx_today_energy ''
	#option idx_module_temp ''
	#option idx_inner_temp ''

	# PVOutput: power, energy today and L1 voltage every pvo_interval s.
	# Empty pvo_system_id = no upload. Keep the key out of this file
	# (it ends up in backups): a file with "name = key" lines, e.g.
	#option pvo_system_id ''
	#option pvo_api_key_file '/root/lib/secrets.conf'
	#option pvo_api_key_name 'sofar_pvo_api_key'
	#option pvo_interval '300'
