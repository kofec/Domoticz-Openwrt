menu "Configuration"
	depends on PACKAGE_domoticz-ng

config DOMOTICZ-NG_PYTHON3
	bool "Enable python3 plugins"
	default y
	help
           Use Python for Plugins and Event-Scripts.
           Enabled by default.

config DOMOTICZ-NG_OPENZWAVE
	bool "Enable OpenZwave support"
	default y
	help
           Enable OpenZwave.
           Enabled by default.

config DOMOTICZ-NG_TELLDUS
	bool "Enable Telldus support"
	default y
	help
           Enable Telldus.
           Enabled by default.
		   

menu "Hardware drivers"

config DOMOTICZ-NG_HW_SELECT
	bool "Build only selected hardware drivers"
	default n
	help
	  Off: every hardware driver is built, as upstream does.
	  On: only the drivers ticked below are compiled and linked
	  (patch 030, cmake -DINCLUDE_HARDWARE_ALL=OFF). Always built:
	  dummy, MQTT client, Domoticz remote server, Python plugins
	  (DOMOTICZ-NG_PYTHON3) and OpenZWave (DOMOTICZ-NG_OPENZWAVE).
	  Hardware of a type left out stays in the database but does not
	  start. openwrt/domoticz_hw_moduly.py in MojeRepo lists what the
	  running instances need.

if DOMOTICZ-NG_HW_SELECT

