From 7a1d0df72a9266461658c7fc8caac2df016a8500 Mon Sep 17 00:00:00 2001
From: Kofec <18610805+kofec@users.noreply.github.com>
Date: Thu, 22 Oct 2026 16:35:47 +0200
Subject: [PATCH] Enigma2: nBox monitor devices without resources (Mode4=2)

Local change, not for upstream. Mode4 becomes a choice: 0 none, 1 units
3..13 (as before), 2 units 3..8 only - for a box running collectd, which
sends root FS, HDD, RAM, CPU and HDD temperature to RRD on a router.
Units 9..13 are then neither created nor listed in the nbox_monitor.conf
line, so the script stops pushing them; ones created earlier stay. The
hardware page shows a select instead of the checkbox; 0 and 1 keep their
meaning. Same values as the Port field 1/2/3 of the Python plugin 3.4.0.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hardware/Enigma2.cpp                      | 17 +++++++++++++----
 hardware/Enigma2.h                        |  2 +-
 www/app/hardware/extra/Enigma2Params.html |  8 ++++++--
 www/app/hardware/extra/Enigma2Params.js   |  4 ++--
 4 files changed, 22 insertions(+), 9 deletions(-)

diff --git a/hardware/Enigma2.cpp b/hardware/Enigma2.cpp
index d17c0758..3004572e 100644
--- a/hardware/Enigma2.cpp
+++ b/hardware/Enigma2.cpp
@@ -20,8 +20,9 @@
 // A box whose web interface is silent but which still answers ping (Enigma2 restarting) keeps its last state.
 //
 // Mode1: poll interval in seconds, Mode2: deep standby supported (0/1), Mode3: show channel name (0/1)
-// Mode4: nBox monitor devices (0/1) - units 3..13 for nbox_monitor.sh on the box, which pushes them with
-//        json.htm udevice; the hardware only creates them (same units as the Enigma2 Python plugin)
+// Mode4: nBox monitor devices - 0 none, 1 units 3..13, 2 units 3..8 (root FS, HDD, RAM, CPU and HDD temperature
+//        come from collectd on the box). nbox_monitor.sh pushes them with json.htm udevice; the hardware only
+//        creates them (same units as the Enigma2 Python plugin, whose Port field 1/2/3 means the same)
 
 #define ENIGMA2_UNIT_STATUS 1
 #define ENIGMA2_UNIT_SOURCE 2
@@ -50,6 +51,11 @@ static const _tEnigma2MonitorUnit Enigma2MonitorUnits[] = {
 	{ 13, "HDD temperature", pTypeTEMP, sTypeTEMP5, nullptr, "DZ_HDD_TEMP" },
 };
 
+#define ENIGMA2_MONITOR_NONE 0
+#define ENIGMA2_MONITOR_ALL 1
+#define ENIGMA2_MONITOR_NO_RESOURCES 2
+#define ENIGMA2_UNIT_FIRST_RESOURCE 9
+
 #define ENIGMA2_POWER_DEEPSTANDBY 1
 #define ENIGMA2_POWER_REBOOT 2
 #define ENIGMA2_POWER_RESTARTE2 3
@@ -65,7 +71,7 @@ CEnigma2::CEnigma2(const int ID, const std::string &IPAddress, const unsigned sh
 	, m_iPollInterval(pollInterval)
 	, m_bDeepStandby(deepStandby != 0)
 	, m_bChannelName(channelName != 0)
-	, m_bMonitorDevices(monitorDevices != 0)
+	, m_iMonitorDevices(monitorDevices)
 {
 	m_HwdID = ID;
 	if (m_iPollInterval < 10)
@@ -149,7 +155,7 @@ void CEnigma2::CreateDevices()
 		}
 	}
 
-	if (m_bMonitorDevices)
+	if (m_iMonitorDevices != ENIGMA2_MONITOR_NONE)
 		CreateMonitorDevices();
 }
 
@@ -162,6 +168,9 @@ void CEnigma2::CreateMonitorDevices()
 
 	for (const auto &mon : Enigma2MonitorUnits)
 	{
+		// left out of the nbox_monitor.conf line too, so the script stops pushing them
+		if ((m_iMonitorDevices == ENIGMA2_MONITOR_NO_RESOURCES) && (mon.unit >= ENIGMA2_UNIT_FIRST_RESOURCE))
+			continue;
 		result = m_sql.safe_query("SELECT ID FROM DeviceStatus WHERE (HardwareID==%d) AND (Unit==%d)", m_HwdID, mon.unit);
 		if (result.empty())
 		{
diff --git a/hardware/Enigma2.h b/hardware/Enigma2.h
index 10f6dbf8..024365fa 100644
--- a/hardware/Enigma2.h
+++ b/hardware/Enigma2.h
@@ -37,7 +37,7 @@ class CEnigma2 : public CDomoticzHardwareBase
 	int m_iPollInterval;
 	bool m_bDeepStandby;
 	bool m_bChannelName;
-	bool m_bMonitorDevices;
+	int m_iMonitorDevices;
 	bool m_bInfoLogged = false;
 	bool m_bWebIfDown = false;
 	std::string m_szLastChannel;
diff --git a/www/app/hardware/extra/Enigma2Params.html b/www/app/hardware/extra/Enigma2Params.html
index 7e3b1e4e..03852b77 100644
--- a/www/app/hardware/extra/Enigma2Params.html
+++ b/www/app/hardware/extra/Enigma2Params.html
@@ -32,8 +32,12 @@
 			<label for="monitorenigma2"><span data-i18n="nBox monitor devices">nBox monitor devices</span>: </label>
 		</td>
 		<td>
-			<input type="checkbox" id="monitorenigma2"><br>
-			<span data-i18n="Creates the sensors filled by nbox_monitor.sh on the box (signal, ECM, disk, RAM, CPU).">Creates the sensors filled by nbox_monitor.sh on the box (signal, ECM, disk, RAM, CPU).</span><br>
+			<select id="monitorenigma2" class="combobox ui-corner-all">
+				<option value="0" data-i18n="No">No</option>
+				<option value="1" data-i18n="Yes">Yes</option>
+				<option value="2" data-i18n="Yes, resources in collectd">Yes, resources in collectd</option>
+			</select><br>
+			<span data-i18n="Creates the sensors filled by nbox_monitor.sh on the box (signal, ECM, disk, RAM, CPU). With collectd on the box disk, RAM and CPU are left out.">Creates the sensors filled by nbox_monitor.sh on the box (signal, ECM, disk, RAM, CPU). With collectd on the box disk, RAM and CPU are left out.</span><br>
 		</td>
 	</tr>
 </table>
diff --git a/www/app/hardware/extra/Enigma2Params.js b/www/app/hardware/extra/Enigma2Params.js
index 3ed56fa4..28ccdaa0 100644
--- a/www/app/hardware/extra/Enigma2Params.js
+++ b/www/app/hardware/extra/Enigma2Params.js
@@ -9,7 +9,7 @@ extraHWInitParams = function (data) {
 	$('#hardwarecontent #divextrahwparams #updatefrequencyenigma2').val(data["Mode1"]);
 	$('#hardwarecontent #divextrahwparams #deepstandbyenigma2').prop('checked', data["Mode2"] == 1);
 	$('#hardwarecontent #divextrahwparams #channelnameenigma2').prop('checked', data["Mode3"] == 1);
-	$('#hardwarecontent #divextrahwparams #monitorenigma2').prop('checked', data["Mode4"] == 1);
+	$('#hardwarecontent #divextrahwparams #monitorenigma2').val((data["Mode4"] == 1 || data["Mode4"] == 2) ? data["Mode4"] : 0);
 	$("#hardwarecontent #divremote #tcpaddress").val(data["Address"] ? data["Address"] : "");
 	$("#hardwarecontent #divremote").show();
 	$("#hardwarecontent #divlogin").show();
@@ -20,7 +20,7 @@ extraHWUpdateParams = function(validators) {
 	data["Mode1"] = $("#hardwarecontent #divextrahwparams #updatefrequencyenigma2").val();
 	data["Mode2"] = $("#hardwarecontent #divextrahwparams #deepstandbyenigma2").is(":checked") ? 1 : 0;
 	data["Mode3"] = $("#hardwarecontent #divextrahwparams #channelnameenigma2").is(":checked") ? 1 : 0;
-	data["Mode4"] = $("#hardwarecontent #divextrahwparams #monitorenigma2").is(":checked") ? 1 : 0;
+	data["Mode4"] = $("#hardwarecontent #divextrahwparams #monitorenigma2").val();
 	if(!extraHWValidateParams(data, validators))
 		return false;
 	return data;
-- 
