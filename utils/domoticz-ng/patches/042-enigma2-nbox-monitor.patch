 	bool m_bInfoLogged = false;
 	bool m_bWebIfDown = false;
 	std::string m_szLastChannel;
diff --git a/main/mainworker.cpp b/main/mainworker.cpp
index 69f4be6b..659fcaba 100644
--- a/main/mainworker.cpp
+++ b/main/mainworker.cpp
@@ -1325,7 +1325,7 @@ bool MainWorker::AddHardwareFromParams(
 #endif
 #ifdef WITH_HW_ENIGMA2
 	case HTYPE_Enigma2:
-		pHardware = new CEnigma2(ID, Address, Port, Username, Password, Mode1, Mode2, Mode3);
